# Server
PORT=3000
NODE_ENV=production

# Security - Admin Panel থেকে এই key দিয়ে request পাঠাবেন
# কমপক্ষে 32 character এর strong random string ব্যবহার করুন
API_SECRET_KEY=your_super_secret_api_key_here_change_this_immediately

# Firebase
FIREBASE_PROJECT_ID=game-club-zone
FIREBASE_DATABASE_URL=https://game-club-zone-default-rtdb.firebaseio.com/

# Firebase Service Account (JSON string হিসেবে রাখুন)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# তারপর পুরো JSON কে এক লাইনে করে এখানে বসান (quotes সহ)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"game-club-zone",...}
